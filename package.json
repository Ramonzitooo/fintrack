{
  "name": "fintrack-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js --port=3000 --host=0.0.0.0",
    "build": "node node_modules/vite/bin/vite.js build && node scripts/build-standalone.js",
    "build:standalone": "node scripts/build-standalone.js",
    "preview": "node node_modules/vite/bin/vite.js preview",
    "clean": "node -e \"const fs = require('fs'); fs.rmSync('dist', { recursive: true, force: true });\"",
    "lint": "node node_modules/typescript/bin/tsc --noEmit",
    "test": "node --import tsx src/utils/financeMath.test.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "express": "^4.21.2",
    "dotenv": "^17.2.3",
    "motion": "^12.23.24"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^5.8.2",
    "@types/express": "^4.17.21"
  }
}
